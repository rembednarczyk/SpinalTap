{
  "name": "seki-senshi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @seki/app dev",
    "build": "pnpm --filter @seki/app build",
    "preview": "pnpm --filter @seki/app preview",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "depcheck": "depcruise packages --config dependency-cruiser.config.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "e2e": "bash tools/e2e.sh",
    "ci": "pnpm typecheck && pnpm lint && pnpm depcheck && pnpm test:coverage && pnpm build && pnpm test:e2e",
    "artifact": "pnpm build && node tools/build-artifact.mjs",
    "osm:fetch": "node tools/osm-import/src/fetch.ts",
    "osm:build": "node tools/osm-import/src/build.ts",
    "osm:preview": "node tools/osm-import/src/preview.ts",
    "osm:props": "node tools/osm-import/src/props.ts",
    "osm:hydrants": "node tools/osm-import/src/fetch-hydrants.ts",
    "osm:entrances": "node tools/osm-import/src/fetch-entrances.ts",
    "osm:trees": "node tools/osm-import/src/fetch-trees.ts",
    "gugik:fetch": "NODE_USE_ENV_PROXY=1 node tools/gugik/src/fetch.ts",
    "gugik:extract": "node tools/gugik/src/extract.ts",
    "gugik:report": "node tools/gugik/src/report.ts",
    "changelog": "node tools/changelog/changelog.mjs",
    "scan:diff": "node tools/glitch-scan/src/scan-diff.ts",
    "scan:walk-coverage": "node tools/glitch-scan/src/walk-coverage-cli.ts",
    "scan:update": "GLITCH_BASELINE=update vitest run tools/glitch-scan/test/glitch-scan.test.ts",
    "shots:compare": "node tools/shots/src/compare.ts",
    "bench:ab": "node tools/bench-ab/src/bench.ts",
    "test:rerun": "node tools/test-rerun/src/rerun.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
